# ==========================================
# SpendWise Backend — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Application
APP_NAME="SpendWise API"
APP_ENV="development"          # development | production
DEBUG=true                     # true | false (MUST be false in production)
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Format: mysql+asyncmy://user:password@host:port/database
#
# Local MariaDB:
#   DATABASE_URL="mysql+asyncmy://root:password@127.0.0.1:3307/spendwise"
#
# Aiven MySQL (cloud):
#   DATABASE_URL="mysql+asyncmy://avnadmin:<password>@<host>:<port>/defaultdb"
#
DATABASE_URL="mysql+asyncmy://user:password@host:port/database"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# SSL Configuration
# Set to true when using Aiven or any cloud MySQL that requires SSL
DATABASE_SSL_REQUIRED=true
# Path to the CA certificate file, OR leave empty to skip cert verification
# Download from your Aiven dashboard → CA certificate → Download
DATABASE_CA_CERT="./certs/ca.pem"

# ------------------------------------------
# JWT Security (REQUIRED)
# ------------------------------------------
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="<generate-a-strong-secret-key-min-32-chars>"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------
# CORS / Networking
# ------------------------------------------
# Development:
FRONTEND_ORIGIN="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
# Production (update with your Vercel domain):
# FRONTEND_ORIGIN="https://your-app.vercel.app"
# CORS_ORIGINS="https://your-app.vercel.app"

# ------------------------------------------
# Feature Toggles
# ------------------------------------------
ENABLE_ANALYTICS=true
ENABLE_BACKUP_IMPORT=true
MAX_TRANSACTIONS_PER_USER=10000
